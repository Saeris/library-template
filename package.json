{
  "name": "library-template",
  "version": "0.0.0",
  "description": "A minimal repo configured with modern JavaScript tooling to scaffold new libraries",
  "keywords": [],
  "homepage": "https://github.com/Saeris/library-template#readme",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saeris/library-template.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "environment": "publish",
    "publish": true
  },
  "devDependencies": {
    "@saeris/configs": "^1.6.1",
    "@types/node": "^26.6.6",
    "@varlock/bumpy": "^1.19.0",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
